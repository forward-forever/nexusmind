MYSQL_DATABASE=nexusmind
MYSQL_USER=nexusmind
MYSQL_PASSWORD=change_me_mysql
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_PORT=3306

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

TZ=Asia/Shanghai

# Spring Boot local profile. Keep these values aligned with the MySQL settings above.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexusmind
DB_USERNAME=nexusmind
DB_PASSWORD=change_me_mysql

# NexusMind server local file storage and character-based chunking.
NEXUSMIND_STORAGE_ROOT=/path/to/.nexusmind/storage
NEXUSMIND_MAX_FILE_SIZE=20MB
NEXUSMIND_CHUNK_SIZE_CHARS=500
NEXUSMIND_CHUNK_OVERLAP_CHARS=100

# Dense vector indexing. Keep API keys only in the untracked deploy/.env file.
DASHSCOPE_API_KEY=replace_with_local_dashscope_api_key
# Use the openAiCompatible base URL from the Model Studio workspace credential file.
# Do not append /embeddings; Spring AI adds that resource path.
EMBEDDING_BASE_URL=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_TIMEOUT=60s
EMBEDDING_MAX_RETRIES=1
NEXUSMIND_EMBEDDING_BATCH_SIZE=15
NEXUSMIND_EMBEDDING_MAX_BATCH_CHARS=7500
# Chat uses the same workspace-compatible API host, but has its own explicit setting.
CHAT_BASE_URL=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHAT_TIMEOUT=60s
CHAT_MAX_RETRIES=1
NEXUSMIND_CHAT_STREAM_TIMEOUT=120s
NEXUSMIND_CHAT_MVC_TIMEOUT=150s
# qwen3.7-text-rerank uses the DashScope Text Rerank API, not the OpenAI-compatible path.
NEXUSMIND_RERANK_ENABLED=false
RERANK_BASE_URL=https://ws-your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1
RERANK_TIMEOUT=3s
MILVUS_URI=http://localhost:19530
