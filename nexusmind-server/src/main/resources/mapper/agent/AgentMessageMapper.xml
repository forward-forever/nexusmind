<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wude.nexusmind.agent.memory.mapper.AgentMessageMapper">

    <resultMap id="agentMessageResultMap" type="com.wude.nexusmind.agent.memory.domain.AgentMessageEntity">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_message (session_id, role, content)
        VALUES (#{sessionId}, #{role}, #{content})
    </insert>

    <select id="findRecentBySessionId" resultMap="agentMessageResultMap">
        SELECT id, session_id, role, content, created_at
        FROM agent_message
        WHERE session_id = #{sessionId}
        ORDER BY id DESC
        LIMIT #{limit}
    </select>

</mapper>
