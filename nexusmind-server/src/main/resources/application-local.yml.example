spring:
  config:
    activate:
      on-profile: local
  ai:
    model:
      chat: openai
      embedding: openai
    openai:
      chat:
        base-url: ${CHAT_BASE_URL}
        api-key: ${DASHSCOPE_API_KEY}
        model: ${nexusmind.ai.chat.model}
        temperature: ${nexusmind.ai.chat.temperature}
        extra-body:
          enable_thinking: false
        timeout: ${CHAT_TIMEOUT:60s}
        max-retries: ${CHAT_MAX_RETRIES:1}
      embedding:
        base-url: ${EMBEDDING_BASE_URL}
        api-key: ${DASHSCOPE_API_KEY}
        model: ${nexusmind.ai.embedding.model}
        dimensions: ${nexusmind.ai.embedding.dimension}
        encoding-format: float
        timeout: ${EMBEDDING_TIMEOUT:60s}
        max-retries: ${EMBEDDING_MAX_RETRIES:1}
  datasource:
    url: jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/${DB_NAME:nexusmind}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia%2FShanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${DB_USERNAME:nexusmind}
    password: ${DB_PASSWORD}
    hikari:
      maximum-pool-size: 5
      minimum-idle: 1
  flyway:
    enabled: true
    locations: classpath:db/migration
    validate-on-migrate: true
    clean-disabled: true

mybatis:
  mapper-locations: classpath*:mapper/knowledge/*.xml
  configuration:
    map-underscore-to-camel-case: true
    default-enum-type-handler: org.apache.ibatis.type.EnumTypeHandler

nexusmind:
  vector:
    enabled: true
  rag:
    enabled: true
    retriever: ${NEXUSMIND_RAG_RETRIEVER:DENSE}
    hybrid:
      rrf:
        k: 60
      route-candidate-multiplier: 4
      min-route-candidates: 20
      max-route-candidates: 60
  ai:
    embedding:
      model: qwen3.7-text-embedding-flash
      dimension: 1024
      batch-size: ${NEXUSMIND_EMBEDDING_BATCH_SIZE:15}
      max-batch-chars: ${NEXUSMIND_EMBEDDING_MAX_BATCH_CHARS:7500}
    chat:
      model: qwen3.5-flash
      temperature: 0.2
      default-top-k: 5
      max-top-k: 10
      max-context-chars: 12000
      stream-timeout: ${NEXUSMIND_CHAT_STREAM_TIMEOUT:120s}
      mvc-timeout: ${NEXUSMIND_CHAT_MVC_TIMEOUT:150s}
    rerank:
      enabled: ${NEXUSMIND_RERANK_ENABLED:false}
      model: qwen3.7-text-rerank
      base-url: ${RERANK_BASE_URL:}
      api-key: ${DASHSCOPE_API_KEY:}
      timeout: ${RERANK_TIMEOUT:3s}
      instruct: Given a web search query, retrieve relevant passages that answer the query.
  milvus:
    enabled: true
    uri: ${MILVUS_URI:http://localhost:19530}
    content-max-length: 8192
    ready-timeout: 30s
    hnsw:
      m: 32
      ef-construction: 200
      ef: 64
    bm25:
      inverted-index-algo: DAAT_MAXSCORE
      k1: 1.2
      b: 0.75
      analyzer: chinese
  storage:
    root: ${NEXUSMIND_STORAGE_ROOT:${user.home}/.nexusmind/storage}
    max-file-size: ${NEXUSMIND_MAX_FILE_SIZE:20MB}
  chunking:
    chunk-size-chars: ${NEXUSMIND_CHUNK_SIZE_CHARS:500}
    chunk-overlap-chars: ${NEXUSMIND_CHUNK_OVERLAP_CHARS:100}
